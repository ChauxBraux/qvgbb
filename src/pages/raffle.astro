---
import Layout from '../layouts/Layout.astro';
import { raffle, isRaffleLive } from '../lib/raffle';
const live = isRaffleLive();
---
<Layout title="Father's Day Golf Raffle" description="Enter the QV Girls Basketball Boosters Father's Day Golf Raffle for a chance to win a premium golf package. $20 per chance. All proceeds support the program.">
  <section class="bg-qvblack text-white relative overflow-hidden">
    <div class="absolute inset-0">
      <img src={raffle.heroImage} alt="" class="w-full h-full object-cover opacity-40" />
    </div>
    <div class="container-narrow relative py-16 md:py-24">
      <p class="text-qvgold font-display uppercase tracking-[0.3em] text-sm mb-3">QV Girls Basketball Boosters</p>
      <h1 class="font-display text-4xl md:text-6xl font-bold uppercase leading-none mb-6">
        Father's Day<br/><span class="text-qvgold">Golf Raffle</span>
      </h1>
      <p class="text-lg md:text-xl text-gray-200 max-w-2xl mb-8">
        <em>FORE!</em> Enter for a chance to win a premium golf package. {raffle.ticketPrice}. All proceeds benefit QVHS Girls Basketball Boosters.
      </p>
      {live ? (
        <a href={raffle.zeffyUrl} target="_blank" rel="noopener" class="btn-primary">Buy Tickets on Zeffy &rarr;</a>
      ) : (
        <div class="inline-block bg-qvgold text-qvblack px-6 py-4">
          <p class="font-display uppercase tracking-wider text-sm">Raffle has ended</p>
          {raffle.winner && <p class="font-display text-xl mt-1">Congratulations to our winner, {raffle.winner}!</p>}
        </div>
      )}
    </div>
  </section>

  <section class="py-16">
    <div class="container-narrow grid md:grid-cols-2 gap-12 items-start">
      <div>
        <h2 class="font-display text-3xl uppercase mb-6">The Prize Package</h2>
        <ul class="space-y-3">
          {raffle.prizes.map(p => (
            <li class="flex gap-3 border-l-4 border-qvgold bg-gray-50 p-4">
              <span class="font-display font-semibold text-qvgold-700">•</span>
              <span class="text-gray-800" set:html={p.replace(/\(([^)]+)\)/, '<span class="text-gray-500">($1)</span>')}></span>
            </li>
          ))}
        </ul>
      </div>

      <div class="space-y-6">
        <div class="border-2 border-qvblack p-6">
          <p class="font-display uppercase tracking-wider text-sm text-qvgold-700 mb-2">Drawing</p>
          <p class="font-display text-2xl">{raffle.drawDate}</p>
          <p class="text-sm text-gray-600 mt-2">Winning ticket will be randomly drawn. Need not be present to win.</p>
        </div>
        <div class="border-2 border-qvblack p-6">
          <p class="font-display uppercase tracking-wider text-sm text-qvgold-700 mb-2">Ticket Price</p>
          <p class="font-display text-2xl">{raffle.ticketPrice}</p>
          <p class="text-sm text-gray-600 mt-2">Tickets sold securely through Zeffy. 100% of your purchase goes to the boosters — Zeffy charges no platform fees to the nonprofit.</p>
        </div>
        {live && (
          <a href={raffle.zeffyUrl} target="_blank" rel="noopener" class="btn-primary w-full text-center">Buy Tickets on Zeffy &rarr;</a>
        )}
      </div>
    </div>
  </section>

  <section class="bg-gray-50 py-12">
    <div class="container-narrow text-center">
      <p class="text-gray-700">Your support keeps the program running. Thank you for stepping up for these girls.</p>
      <p class="text-xs text-gray-500 mt-4">QV Girls Basketball Boosters is a registered 501(c)(3). Raffle ticket purchases are not tax-deductible.</p>
    </div>
  </section>
</Layout>
