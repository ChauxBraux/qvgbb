---
import { raffle, isRaffleLive } from '../lib/raffle';
const show = isRaffleLive();
---
{show && (
  <div class="bg-qvgold text-qvblack">
    <div class="container-narrow py-2.5 flex flex-wrap items-center justify-center gap-x-4 gap-y-1 text-center text-sm sm:text-base">
      <span class="font-display uppercase tracking-wider font-semibold">
        {raffle.title}
      </span>
      <span class="hidden sm:inline">{raffle.ticketPrice} · Drawing June 21</span>
      <a href="/raffle" class="font-display uppercase tracking-wider text-sm font-semibold underline underline-offset-4 hover:no-underline">
        Buy Tickets &rarr;
      </a>
    </div>
  </div>
)}
